# Extracts the geometry-shader generator from Xenia's Vulkan pipeline cache for gl_geometry.cc:
# the body of VulkanPipelineCache::GetGeometryShader after its cache lookup, up to and including
# `builder.dump(shader_code);`. Usage (script mode or include()):
#   cmake -DXE_GS_SRC=<vulkan_pipeline_cache.cc> -DXE_GS_OUT=<xe_geometry_shader_body.inc> -P extract_gs_body.cmake
file(READ "${XE_GS_SRC}" _src)
string(FIND "${_src}" "VulkanPipelineCache::GetGeometryShader(GeometryShaderKey key) {" _fn)
if(_fn EQUAL -1)
  message(FATAL_ERROR "extract_gs_body: GetGeometryShader not found in ${XE_GS_SRC}")
endif()
string(SUBSTRING "${_src}" ${_fn} -1 _src)
string(FIND "${_src}" "std::vector<spv::Id> id_vector_temp;" _begin)
string(FIND "${_src}" "builder.dump(shader_code);" _end)
if(_begin EQUAL -1 OR _end EQUAL -1 OR _end LESS _begin)
  message(FATAL_ERROR "extract_gs_body: generator markers not found (Xenia changed?)")
endif()
math(EXPR _len "${_end} - ${_begin} + 26")   # 26 = length of the end marker
string(SUBSTRING "${_src}" ${_begin} ${_len} _body)
file(WRITE "${XE_GS_OUT}" "// Generated by switch/tools/extract_gs_body.cmake from ${XE_GS_SRC}\n${_body}\n")
