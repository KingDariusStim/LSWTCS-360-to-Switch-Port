# Allow-list: ignore everything, then opt in to our own source.
# Game data (xex/iso/DAT/image.bin/pristine.bin), XenonRecomp output .cpp,
# Xenia dumps, captures, logs and build dirs are deliberately NOT tracked.
/*
!/.gitignore
!/README.md
!/LICENSE
!/HANDOFF_*.md
!/backup.sh
!/run.sh
!/*.ps1
!/ladscan.c
!/ghidra_scripts/
!/patches/
!/switch/
/switch/scratch/
*.elf
*.nro
*.nacp

!/LSWTCSRuntime/
/LSWTCSRuntime/*
!/LSWTCSRuntime/CMakeLists.txt
!/LSWTCSRuntime/ffmpeg_sources.cmake
!/LSWTCSRuntime/source/
!/LSWTCSRuntime/include/
!/LSWTCSRuntime/xenos/
!/LSWTCSRuntime/xenos_dxbc/
!/LSWTCSRuntime/xma/

!/Convert 360/
/Convert 360/*
!/Convert 360/LSWTCS/
/Convert 360/LSWTCS/*
!/Convert 360/LSWTCS/*.toml
!/Convert 360/LSWTCS/*.patch.txt

*.bak
build/

# Eden (Nintendo Switch emulator, local testing only) and anything tied to the user's own console:
# key files and cartridge/title dumps must never be committed, wherever they end up.
/Eden/
*.keys
*.xci
*.nsp
*.nca

# Our own scripts (recomp post-passes: live-in, data-prefix, switch ERROR repairs; Ghidra/bisect helpers).
!/tools/
__pycache__/
# Run output: console / Eden logs, captures and memory dumps (hundreds of MB), per-build logs.
/switch/hwlogs/
/switch/build_*.log
# Forwarder: only the build script is ours; the rest is build output and vendored code.
/switch/forwarder/*
!/switch/forwarder/build_forwarder.sh
# Generated from the recompiled guest reverb by tools/gen_native_reverb.py (derived from the game code).
/LSWTCSRuntime/source/native_reverb_gen.inc
