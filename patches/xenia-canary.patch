+bool SpirvShaderTranslator::LswForwardOnlyControlFlow() {
+  const Shader& shader = current_shader();
+  if (shader.label_addresses().empty()) {
+    return false;
+  }
+  const uint32_t* dwords = shader.ucode_dwords();
+  struct Region { uint32_t start, end; };   // loop start / loop end cf index
+  std::vector<Region> regions, stack;
+  std::vector<std::pair<uint32_t, uint32_t>> jumps;   // (cf index, target)
+  std::vector<uint32_t> ends, starts;
+  std::vector<uint32_t> start_skip;   // loop start skip addresses (by stack)
+  for (uint32_t i = 0; i < shader.cf_pair_index_bound(); ++i) {
+    ucode::ControlFlowInstruction cf_ab[2];
+    ucode::UnpackControlFlowInstructions(dwords + i * 3, cf_ab);
+    for (uint32_t j = 0; j < 2; ++j) {
+      const uint32_t cf_index = i * 2 + j;
+      switch (cf_ab[j].opcode()) {
+        case ucode::ControlFlowOpcode::kCondCall:
+        case ucode::ControlFlowOpcode::kReturn:
+          return false;
+        case ucode::ControlFlowOpcode::kLoopStart:
+          stack.push_back({cf_index, 0});
+          start_skip.push_back(cf_ab[j].loop_start.address());
+          starts.push_back(cf_index);
+          break;
+        case ucode::ControlFlowOpcode::kLoopEnd: {
+          if (stack.empty()) {
+            return false;
+          }
+          Region r = stack.back();
+          stack.pop_back();
+          const uint32_t skip = start_skip.back();
+          start_skip.pop_back();
+          // Body right after the start, skip right after the end.
+          if (cf_ab[j].loop_end.address() != r.start + 1 ||
+              skip != cf_index + 1) {
+            return false;
+          }
+          r.end = cf_index;
+          regions.push_back(r);
+        } break;
+        case ucode::ControlFlowOpcode::kCondJmp:
+          jumps.emplace_back(cf_index, cf_ab[j].cond_jmp.address());
+          break;
+        case ucode::ControlFlowOpcode::kExecEnd:
+        case ucode::ControlFlowOpcode::kCondExecEnd:
+        case ucode::ControlFlowOpcode::kCondExecPredEnd:
+        case ucode::ControlFlowOpcode::kCondExecPredCleanEnd:
+          ends.push_back(cf_index);
+          break;
+        default:
+          break;
+      }
+    }
+  }
+  if (!stack.empty()) {
+    return false;
+  }
+  if (!lsw_structured_loops && !regions.empty()) {
+    return false;
+  }
+  // Loop bodies as inclusive cf index ranges [lo, hi]: guest loops (start, end]
+  // and do-while loops [label, backward jump].
+  std::vector<std::pair<uint32_t, uint32_t>> bodies;
+  for (const Region& r : regions) {
+    bodies.emplace_back(r.start + 1, r.end);
+  }
+  std::vector<uint32_t> heads;
+  for (const auto& jump : jumps) {
+    if (jump.second <= jump.first) {
+      if (!lsw_structured_loops) {
+        return false;
+      }
+      for (uint32_t h : heads) {
+        if (h == jump.second) {
+          return false;   // one backward jump per loop head
+        }
+      }
+      heads.push_back(jump.second);
+      bodies.emplace_back(jump.second, jump.first);
+    }
+  }
+  // Properly nested.
+  for (size_t a = 0; a < bodies.size(); ++a) {
+    for (size_t b = a + 1; b < bodies.size(); ++b) {
+      const auto& x = bodies[a];
+      const auto& y = bodies[b];
+      const bool disjoint = x.second < y.first || y.second < x.first;
+      const bool x_in_y = y.first <= x.first && x.second <= y.second;
+      const bool y_in_x = x.first <= y.first && y.second <= x.second;
+      if (!disjoint && !x_in_y && !y_in_x) {
+        return false;
+      }
+      if (x == y) {
+        return false;
+      }
+    }
+  }
+  // Innermost body containing a cf index.
+  auto innermost = [&](uint32_t idx) -> int {
+    int best = -1;
+    for (size_t k = 0; k < bodies.size(); ++k) {
+      if (bodies[k].first <= idx && idx <= bodies[k].second &&
+          (best < 0 || bodies[k].first > bodies[size_t(best)].first ||
+           (bodies[k].first == bodies[size_t(best)].first &&
+            bodies[k].second < bodies[size_t(best)].second))) {
+        best = int(k);
+      }
+    }
+    return best;
+  };
+  for (uint32_t e : ends) {
+    if (innermost(e) >= 0) {
+      return false;   // exece inside a loop: would break out of two loops
+    }
+  }
+  for (const auto& jump : jumps) {
+    if (jump.second <= jump.first) {
+      continue;   // the backward jump closing a do-while
+    }
+    if (innermost(jump.first) != innermost(jump.second)) {
+      return false;
+    }
+    for (const auto& body : bodies) {
+      if (jump.first < body.first && body.first < jump.second) {
+        return false;   // the jump would skip a whole loop
+      }
+    }
+  }
+  lsw_dowhile_heads_ = heads;
+  return true;
+}
+
+void SpirvShaderTranslator::LswOpenSkipGuard() {
+  if (lsw_skip_guard_merge_) {
+    return;
+  }
+  EnsureBuildPointAvailable();
+  spv::Id not_skipping = builder_->createBinOp(
+      spv::OpIEqual, type_bool_,
+      builder_->createLoad(var_lsw_skip_, spv::NoPrecision), const_int_0_);
+  lsw_skip_guard_merge_ = new spv::Block(
+      builder_->getUniqueId(), builder_->getBuildPoint()->getParent());
+  builder_->createSelectionMerge(lsw_skip_guard_merge_,
+                                 spv::SelectionControlMaskNone);
+  spv::Block& inner_block = builder_->makeNewBlock();
+  builder_->createConditionalBranch(not_skipping, &inner_block,
+                                    lsw_skip_guard_merge_);
+  builder_->setBuildPoint(&inner_block);
+}
+
+void SpirvShaderTranslator::LswCloseSkipGuard() {
+  if (!lsw_skip_guard_merge_) {
+    return;
+  }
+  spv::Block& inner_block = *builder_->getBuildPoint();
+  if (!inner_block.isTerminated()) {
+    builder_->createBranch(lsw_skip_guard_merge_);
+  }
+  inner_block.getParent().addBlock(lsw_skip_guard_merge_);
+  builder_->setBuildPoint(lsw_skip_guard_merge_);
+  lsw_skip_guard_merge_ = nullptr;
+}
