--- output_locals_raw_folded/lsw_fixgate.h	1969-12-31 19:00:00.000000000 -0500
+++ output/lsw_fixgate.h	2026-10-10 23:26:29.916524600 -0400
@@ -0,0 +1,25 @@
+// tools/fix_switch_gate.py: run-time switch for the ERROR-return repairs (LSW_SWITCH_FIX / LSW_SWITCH_MID).
+// LSWTCS_FIXOFF="lo-hi,lo-hi,..." (hex function addresses, inclusive; a single address works too): repairs inside those
+// functions are off and the site returns as XenonRecomp emitted it. For bisecting a repair that changes behaviour.
+#pragma once
+#include <cstdint>
+#include <cstdlib>
+inline bool lsw_fixon(uint32_t func) {
+    struct Ranges { uint32_t n = 0, lo[64] = {}, hi[64] = {}; };
+    static const Ranges r = [] {
+        Ranges x;
+        const char* e = getenv("LSWTCS_FIXOFF");
+        while (e && *e && x.n < 64) {
+            char* end;
+            x.lo[x.n] = uint32_t(strtoul(e, &end, 16));
+            x.hi[x.n] = x.lo[x.n];
+            if (*end == '-') x.hi[x.n] = uint32_t(strtoul(end + 1, &end, 16));
+            ++x.n;
+            e = *end == ',' ? end + 1 : nullptr;
+        }
+        return x;
+    }();
+    for (uint32_t i = 0; i < r.n; ++i)
+        if (func >= r.lo[i] && func <= r.hi[i]) return false;
+    return true;
+}
