-#define PPC_FUNC_PROLOGUE() __builtin_assume(((size_t)base & 0x1F) == 0)
+// GIL fairness (LSWTCS_GIL): a cheap racy counter incremented on every guest function
+// entry; every 1024th entry calls the (gated) quantum yield so a pure guest spin-wait
+// — which never hits a kernel primitive — still periodically releases the GIL, letting
+// the worker threads run. Zero-cost when GIL is off (lswtcs_gil_quantum early-returns,
+// and the inc+branch is predicted-not-taken). Defined in kernel_stubs.cpp.
+extern "C" unsigned lswtcs_gil_ctr;
+extern "C" void lswtcs_gil_quantum();
+#define PPC_FUNC_PROLOGUE() do { __builtin_assume(((size_t)base & 0x1F) == 0); \
+    if (__builtin_expect((((++lswtcs_gil_ctr) & 0x3FFu) == 0u), 0)) lswtcs_gil_quantum(); } while (0)
 
 #ifndef PPC_LOAD_U8
 #define PPC_LOAD_U8(x) *(volatile uint8_t*)(base + (x))
@@ -110,10 +118,61 @@
 
 #define PPC_MEMORY_SIZE 0x100000000ull
 
-#define PPC_LOOKUP_FUNC(x, y) *(PPCFunc**)(x + PPC_IMAGE_BASE + PPC_IMAGE_SIZE + (uint64_t(uint32_t(y) - PPC_CODE_BASE) * 2))
+// Dispatch table lives OUTSIDE guest-usable memory. The XenonRecomp default
+// (PPC_IMAGE_BASE + PPC_IMAGE_SIZE = 0x83460000, extent CODE_SIZE*2 -> 0x84ECA4F8)
+// overlaps the guest main stack (r1=0x835FFEF0), the virtual-heap arena/free-list
+// (0x834xxxxx-0x84xxxxxx, sentinel 0x84000180), and the NtAllocateVirtualMemory bump
+// heap (0x84000000+): host function pointers pre-seed guest heap blocks (the
+// "host 0x7FF6... pointers 0x20 apart in the coin sound entry" corruption) and guest
+// writes clobber dispatch slots. 0xC8000000 sits in the free [0xC0000000,0xE0000000)
+// window (phys bump caps at 0xC0000000, bypass pool starts at 0xE0000000); requires
+// the full-4GB guest VirtualAlloc (always taken in practice).
+#define PPC_FUNC_TABLE_BASE 0x100000000ull  // above the 4GB guest space (0xC0000000 is now a physical-memory alias view)
+#define PPC_LOOKUP_FUNC(x, y) *(PPCFunc**)(x + PPC_FUNC_TABLE_BASE + (uint64_t(uint32_t(y) - PPC_CODE_BASE) * 2))
 
 #ifndef PPC_CALL_INDIRECT_FUNC
-#define PPC_CALL_INDIRECT_FUNC(x) (PPC_LOOKUP_FUNC(base, x))(ctx, base)
+// Guarded indirect dispatch: a corrupt/uninitialized guest function pointer
+// (e.g. 0xFFFFFFFF from an unpopulated vtable/callback slot) would index the
+// function table out of bounds and AV. Validate the target is within the
+// recompiled code range and the resolved host pointer is non-null before
+// calling; otherwise skip the call rather than crash.
+extern "C" void ppc_indirect_skip_log(uint32_t target, uint32_t lr);
+// RAM trace logger (kernel_stubs.cpp) — use INSTEAD of printf in recomp diagnostics
+// to avoid perturbing the timing-fragile load race. Env-gated LSWTCS_TRACE=1.
+extern "C" void dbg_ram(const char* fmt, ...);
+extern "C" uint32_t dbg_tid();    // GetCurrentThreadId
+extern "C" int      dbg_tinit();  // 1 if this thread ran apiThreadStartup per-thread init
+extern "C" void     lswtcs_watch_guest(uint32_t guest_addr);  // arm HW write-watch (LSWTCS_CTXWATCH)
+extern "C" volatile uint32_t g_dbg_ctx_addr;  // live compiler-context addr (set at CTXNEW) for alloc-aliasing check
+void lswtcs_heaptest(struct PPCContext& ctx, uint8_t* base);  // gated free-list self-check (LSWTCS_HEAPTEST)
+extern "C" uint32_t lswtcs_pool_alloc(uint32_t size);  // small-virtual-heap bypass alloc (0 = not handled)
+extern "C" int      lswtcs_pool_free(uint32_t addr);   // returns 1 if addr was ours
+extern "C" volatile int g_emit_fn;   // hang tracker — emit callees set on entry; timer logs it
+// LSWTCS shader-compile abort: the original HLSL compiler's assert/fatal handler (sub_82692AF8)
+// is NORETURN; our recomp makes it return, so dozens of compiler fns that end with a bl to it fall
+// off WITHOUT restoring callee-saved regs -> register corruption -> NULL containers -> emit hang.
+// Systematic fix: setjmp at the compile entry (manager), and longjmp out of sub_82692AF8 when a
+// compile is active = treat any compiler assert as "this shader compile failed", unwinding cleanly.
+extern "C" jmp_buf       g_compile_jmp;    // set at compile entry
+extern "C" volatile int  g_compile_active; // 1 while inside a shader compile (gates the longjmp)
+extern "C" void          lswtcs_compile_abort(uint32_t code, uint32_t caller); // longjmp back to compile entry
+extern "C" int           lswtcs_skip4801(); // 1 = treat empty operand-list as 0 operands (LSWTCS_SKIP4801, default on)
+extern "C" void          lswtcs_dump_mem(uint32_t guest_addr, uint32_t len, const char* tag); // one-shot file dump
+extern "C" uint32_t       lswtcs_fix_semantics(uint32_t src, uint32_t len, uint32_t* outlen); // inject input semantics (LSWTCS_SEMFIX)
+extern "C" void           lswtcs_logresult(uint32_t ret, uint32_t errstr_guest); // printf compile result to h.log
+extern "C" void           lswtcs_logassert(uint32_t key, uint32_t count, uint32_t table); // printf emit binding-lookup key
+extern "C" void           lswtcs_logcmp(uint32_t key, uint32_t ent, uint32_t flags, uint32_t res); // printf per-entry compare
+extern "C" int            lswtcs_pathb_compile(const char* hlsl, uint32_t len); // Path B: game HLSL -> D3D12 shader
+extern "C" uint32_t       lswtcs_stub_source(uint32_t* outlen); // LSWTCS_STUBSRC: trivial source for the game's compiler
+extern "C" void           lswtcs_fix_semtable(); // repair zeroed f4 fields in the D3D semantic table @0x82F317E0
+#define PPC_CALL_INDIRECT_FUNC(x) do { \
+    uint32_t _ppc_it = (uint32_t)(x); \
+    if (_ppc_it >= PPC_CODE_BASE && _ppc_it < (PPC_CODE_BASE + PPC_CODE_SIZE)) { \
+        PPCFunc* _ppc_if = PPC_LOOKUP_FUNC(base, _ppc_it); \
+        if (_ppc_if) { _ppc_if(ctx, base); } \
+        else { ppc_indirect_skip_log(_ppc_it, (uint32_t)ctx.lr); } \
+    } else { ppc_indirect_skip_log(_ppc_it, (uint32_t)ctx.lr); } \
+} while (0)
 #endif
 
 typedef void PPCFunc(struct PPCContext& __restrict__ ctx, uint8_t* base);
