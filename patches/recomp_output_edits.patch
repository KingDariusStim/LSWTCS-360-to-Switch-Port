-#define PPC_FUNC_PROLOGUE() __builtin_assume(((size_t)base & 0x1F) == 0)
+// GIL fairness (LSWTCS_GIL): a cheap racy counter incremented on every guest function
+// entry; every 1024th entry calls the (gated) quantum yield so a pure guest spin-wait
+// — which never hits a kernel primitive — still periodically releases the GIL, letting
+// the worker threads run. Zero-cost when GIL is off (lswtcs_gil_quantum early-returns,
+// and the inc+branch is predicted-not-taken). Defined in kernel_stubs.cpp.
+extern "C" unsigned lswtcs_gil_ctr;
+extern "C" void lswtcs_gil_quantum();
+#define PPC_FUNC_PROLOGUE() do { __builtin_assume(((size_t)base & 0x1F) == 0); \
+    if (__builtin_expect((((++lswtcs_gil_ctr) & 0x3FFu) == 0u), 0)) lswtcs_gil_quantum(); } while (0)
+
+// LSWTCS address fold (LSW_ADDR_FOLD, default 1). The 360's 512 MB of physical memory appears at
+// guest 0x80000000, 0xA0000000 and 0xC0000000. Switch homebrew cannot map one block at several
+// writable addresses (Eden probe #1, 2026-10-06), so every guest access folds the two physical views
+// 0xA0000000-0xDFFFFFFF onto 0x80000000 + (addr & 0x1FFFFFFF): one host copy, branch-free (cmov).
+// LSW_ADDR_FOLD=0 = the old direct base + addr (needs the three host views mapped).
+#ifndef LSW_ADDR_FOLD
+#define LSW_ADDR_FOLD 1
+#endif
+static inline uint32_t ppc_fold(uint32_t a) {
+#if LSW_ADDR_FOLD
+    return (a - 0xA0000000u) < 0x40000000u ? ((a & 0x1FFFFFFFu) | 0x80000000u) : a;
+#else
+    return a;
+#endif
+}
+// Host pointer for a guest address. Every generated guest access (scalar macros below, vector
+// load/store, lwarx/stwcx, dcbz) goes through this. Table form of ppc_fold: ppc_view_base[i] is the
+// host base for guest region i (512 MB each, addr >> 29), set at startup (main.cpp): base for most
+// regions, base - 0x20000000 / base - 0x40000000 for the 0xA0000000 / 0xC0000000 views when folding.
+// Shift + load + add (~2 instructions over base + x) instead of compare + cmov (+20% guest CPU time
+// measured on PC, 2026-10-06). LSW_ADDR_FOLD_CMOV=1 selects the compare form for comparison.
+extern "C" uint8_t* ppc_view_base[8];
+#if defined(LSW_ADDR_FOLD_CMOV) && LSW_ADDR_FOLD_CMOV
+#define PPC_HOST(x) (base + ppc_fold((uint32_t)(x)))
+#else
+#define PPC_HOST(x) (ppc_view_base[(uint32_t)(x) >> 29] + (uint32_t)(x))
+#endif
 
 #ifndef PPC_LOAD_U8
-#define PPC_LOAD_U8(x) *(volatile uint8_t*)(base + (x))
