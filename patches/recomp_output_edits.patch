diff -ruN --strip-trailing-cr output_ref/lswtcs_vmx128.h output/lswtcs_vmx128.h
--- output_ref/lswtcs_vmx128.h	1969-12-31 19:00:00.000000000 -0500
+++ output/lswtcs_vmx128.h	2026-06-15 16:26:35.830849800 -0400
@@ -0,0 +1,37 @@
+#ifndef LSWTCS_VMX128_H
+#define LSWTCS_VMX128_H
+#include <cstdint>
+#include <cstring>
+// ─────────────────────────────────────────────────────────────────────────────
+// VMX128 helpers — Xenos (Xbox 360) half-float <-> float32 conversions.
+// Ported verbatim from Xenia (xenia/base/math.h: float_to_xenos_half /
+// xenos_half_to_float, preserve_denormal=false, round_to_nearest_even=false).
+// XenonRecomp left the vpkd3d128/vupkd3d128 FLOAT16_2/FLOAT16_4 pack/unpack
+// instructions as __builtin_debugtrap() stubs; these are needed once GAME.DAT
+// vertex/asset data streams through the format converters (e.g. sub_822CF978).
+// ─────────────────────────────────────────────────────────────────────────────
+static inline uint16_t lswtcs_float_to_xenos_half(float value) {
+    uint32_t integer_value; std::memcpy(&integer_value, &value, 4);
+    uint32_t abs_value = integer_value & 0x7FFFFFFFu;
+    uint32_t result;
+    if (abs_value >= 0x47FFE000u) {
+        result = 0x7FFFu;                       // saturate to max half
+    } else {
+        if (abs_value < 0x38800000u) {
+            result = 0u;                        // too small -> flush to zero
+        } else {
+            result = abs_value + 0xC8000000u;   // rebias exponent 127->15
+        }
+        result = (result >> 13u) & 0x7FFFu;
+    }
+    return (uint16_t)(result | ((integer_value & 0x80000000u) >> 16u));
+}
+static inline float lswtcs_xenos_half_to_float(uint16_t value) {
+    uint32_t mantissa = value & 0x3FFu;
+    uint32_t exponent = (value >> 10u) & 0x1Fu;
+    if (!exponent) { mantissa = 0u; exponent = (uint32_t)(-112); }  // zero/denormal -> +/-0
+    uint32_t result = ((uint32_t)(value & 0x8000u) << 16u) |
+                      ((exponent + 112u) << 23u) | (mantissa << 13u);
+    float f; std::memcpy(&f, &result, 4); return f;
+}
+#endif // LSWTCS_VMX128_H
